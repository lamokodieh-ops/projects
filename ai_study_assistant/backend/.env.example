FLASK_SECRET_KEY=change-me
CORTEX_API_KEY=dev-cortex-local-key
# Comma-separated browser origins allowed to call /api/*
CORS_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
OPENAI_API_KEY=
# Force mode: auto | live | mock
LLM_MODE=auto
# openai | local | mock  (embeddings; auto picks openai if key else mock)
EMBEDDING_PROVIDER=auto
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
DATA_DIR=./data